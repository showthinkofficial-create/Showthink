rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidEnquiry(data) {
      return data.keys().hasAll([
        'studentName', 'parentName', 'phone', 'currentClass', 
        'admissionClass', 'boardPreference', 'enquiryType', 
        'area', 'preferredContactMethod', 'consent', 'status', 
        'source', 'createdAt'
      ]) && 
      data.keys().size() >= 13 &&
      isValidString(data.studentName, 1, 100) &&
      isValidString(data.parentName, 1, 100) &&
      isValidString(data.phone, 10, 15) &&
      isValidString(data.currentClass, 1, 50) &&
      isValidString(data.admissionClass, 1, 50) &&
      isValidString(data.boardPreference, 1, 50) &&
      isValidString(data.enquiryType, 1, 50) &&
      isValidString(data.area, 1, 200) &&
      isValidString(data.preferredContactMethod, 1, 20) &&
      data.consent is bool &&
      isValidString(data.status, 1, 20) &&
      isValidString(data.source, 1, 20) &&
      isValidString(data.createdAt, 1, 40) &&
      (!('alternatePhone' in data) || isValidString(data.alternatePhone, 0, 15)) &&
      (!('previousSchool' in data) || isValidString(data.previousSchool, 0, 150)) &&
      (!('message' in data) || isValidString(data.message, 0, 1000));
    }

    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && isValidEnquiry(request.resource.data);
      allow get, list, update, delete: if false; // Strict protection of parent PII
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
