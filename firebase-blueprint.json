      "properties": {
        "id": { "type": "string" },
        "portalUserUid": { "type": "string" },
        "studentId": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "section": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "DISABLED"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalUserUid", "studentId", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "ExamResult": {
      "title": "Exam Result",
      "description": "Student examination evaluation record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "className": { "type": "string" },
        "section": { "type": "string" },
        "board": { "type": "string" },
        "examName": { "type": "string" },
        "academicSession": { "type": "string" },
        "subjects": {
          "type": "array",
          "items": { "type": "object" }
        },
        "totalMarks": { "type": "number" },
        "marksObtained": { "type": "number" },
        "percentage": { "type": "number" },
        "grade": { "type": "string" },
        "status": { "type": "string", "enum": ["PASSED", "FAILED", "SUPPLEMENTARY"] },
        "publishedDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentUid", "studentId", "examName", "academicSession", "status"]
    },
    "SchoolSettings": {
      "title": "School Settings",
      "description": "Global institutional configuration, contact information, hours, and branding.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "hoursWeekday": { "type": "string" },
        "hoursWeekend": { "type": "string" },
        "aboutSchool": { "type": "string" },
        "principalMessage": { "type": "string" },
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "address", "phone"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user documents storing user metadata and roles."
    },
    "portalStudentLinks/{linkId}": {
      "schema": "PortalStudentLink",
      "description": "Collection of portal user to student relationship mapping documents."
    },
