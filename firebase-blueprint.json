        "studentName": { "type": "string" },
        "relationship": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "parentUid", "studentId", "studentUid", "createdAt"]
    },
    "PortalStudentLink": {
      "title": "Portal Student Link",
      "description": "Combined portal user mapping between auth UID and student record.",
